<?xml version="1.0" encoding="utf-8"?>
<!--
  Kept deliberately minimal: shared Windows hosts (SmarterASP.NET among them) lock the
  <security><requestFiltering> section and reject <location> wrappers, which makes IIS
  answer 500 on every request without ever starting the app. App_Data is still never served,
  because the aspNetCore handler owns every path and the app has no static-file middleware.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\CampRadar.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>
